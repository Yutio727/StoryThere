<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_activity"
    android:clipToPadding="true"
    android:fitsSystemWindows="true"
    tools:context=".ui.PersonalDataConsentActivity">

    <ScrollView
        android:id="@+id/consentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/consentActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="48dp"
            android:paddingEnd="32dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/ivConsentIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/app_name"
                android:src="@drawable/storythere_icon" />

            <TextView
                android:id="@+id/tvConsentAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/progress_blue"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="StoryThere" />

            <TextView
                android:id="@+id/tvConsentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/montserrat_bold"
                android:gravity="center"
                android:text="@string/personal_data_consent_title"
                android:textColor="@color/text_activity_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvConsentBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/montserrat_regular"
                android:lineSpacingExtra="4dp"
                android:text="@string/personal_data_consent_body"
                android:textColor="@color/text_activity_secondary"
                android:textSize="15sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/checkboxConsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/montserrat_medium"
                android:text="@string/personal_data_consent_checkbox"
                android:textColor="@color/text_activity_primary"
                android:textSize="14sp"
                app:buttonTint="@color/progress_blue" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/consentActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/background_activity"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="12dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptConsent"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/progress_blue"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/personal_data_consent_accept"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeclineConsent"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/personal_data_consent_decline"
            android:textAllCaps="false"
            android:textColor="@color/progress_blue" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
