<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/bottomNavBackground"
        android:elevation="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

    <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="2dp"
            android:background="?attr/selectableItemBackground">

        <ImageView
                android:id="@+id/icon_home"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home_page"
                android:layout_marginBottom="4dp" />

        <TextView
                android:id="@+id/text_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home"
                android:textSize="11sp"
                android:textColor="?attr/bottomNavUnselected"
                android:fontFamily="@font/montserrat" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/nav_catalog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:layout_marginStart="10dp">

        <ImageView
                android:id="@+id/icon_catalog"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_catalog"
                android:layout_marginBottom="4dp" />

        <TextView
                android:id="@+id/text_catalog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/catalog"
                android:textSize="11sp"
                android:textColor="?attr/bottomNavUnselected"
                android:fontFamily="@font/montserrat" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:layout_marginStart="10dp">

        <ImageView
                android:id="@+id/icon_search"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                android:layout_marginBottom="4dp" />

        <TextView
                android:id="@+id/text_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search"
                android:textSize="11sp"
                android:textColor="?attr/bottomNavUnselected"
                android:fontFamily="@font/montserrat" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/nav_my_books"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:layout_marginStart="10dp">

        <ImageView
                android:id="@+id/icon_my_books"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_book"
                android:layout_marginBottom="4dp" />

        <TextView
                android:id="@+id/text_my_books"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_books"
                android:textSize="11sp"
                android:textColor="?attr/bottomNavUnselected"
                android:fontFamily="@font/montserrat" />
    </LinearLayout>

    <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="2dp"
            android:layout_marginStart="10dp">

        <ImageView
                android:id="@+id/icon_profile"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_user"
                android:layout_marginBottom="4dp" />

        <TextView
                android:id="@+id/text_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textSize="11sp"
                android:textColor="?attr/bottomNavUnselected"
                android:fontFamily="@font/montserrat" />
    </LinearLayout>

</LinearLayout>
